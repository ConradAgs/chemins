T07_INDICATEURS_PERIODE =
VAR _def =
    DATATABLE (
        "Indicateur", STRING,
        "Ordre_Indicateur", INTEGER,
        "Type_Valeur", STRING,
        {
            { "Note de qualité ESG", 1, "Nombre" },
            { "Note ESG", 2, "Texte" },
            { "Empreinte carbone", 3, "Nombre" },
            { "Investissement durable", 4, "Pourcentage" },
            // { "Taxonomie", 5, "Pourcentage" },
            { "Couverture de la notation ESG", 6, "Pourcentage" },
            { "Couverture de l'empreinte carbone", 7, "Pourcentage" }
        }
    )
RETURN
    SELECTCOLUMNS (
        CROSSJOIN ( ALL_KPI, _def ),
        "Nom ptf", ALL_KPI[Nom ptf],
        "Type_Entite", ALL_KPI[Type_Entite],
        "Date_Maj", ALL_KPI[Date_Maj],
        "Mois", ALL_KPI[Mois],
        "Periode",
            VAR _p = FORMAT ( ALL_KPI[Date_Maj], "mmmm yyyy", "fr-FR" )
            RETURN UPPER ( LEFT ( _p, 1 ) ) & MID ( _p, 2, LEN ( _p ) ),
        "Periode_Tri", YEAR ( ALL_KPI[Date_Maj] ) * 100 + MONTH ( ALL_KPI[Date_Maj] ),
        "Indicateur", [Indicateur],
        "Ordre_Indicateur", [Ordre_Indicateur],
        "Type_Valeur", [Type_Valeur],
        "Valeur",
            SWITCH (
                [Ordre_Indicateur],
                1, ALL_KPI[ESG],
                2, BLANK (),
                3, ALL_KPI[Carbon],
                4, ALL_KPI[Green_Effectif],
                // 5, ALL_KPI[Taxonomie],
                6, ALL_KPI[Couverture_Poche_Eligible_ESG],
                7, ALL_KPI[Couverture_Poche_Eligible_Carbone]
            ),
        "Valeur_Texte",
            IF ( [Ordre_Indicateur] = 2, ALL_KPI[Rating_ESG], BLANK () )
    )
